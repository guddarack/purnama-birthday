<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Selamat Ulang Tahun PURNAMA 🎉</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    overflow:hidden;
    background:linear-gradient(135deg,#ff7eb3,#ff758c,#ffb199);
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.container{
    width:90%;
    max-width:600px;
    background:rgba(255,255,255,.15);
    backdrop-filter:blur(8px);
    border-radius:20px;
    padding:35px;
    text-align:center;
    color:white;
    box-shadow:0 10px 25px rgba(0,0,0,.2);
    z-index:2;
}

h1{
    font-size:40px;
    margin-bottom:15px;
    animation:pulse 1.8s infinite;
}

p{
    font-size:20px;
    margin-bottom:25px;
}

button{
    padding:15px 35px;
    border:none;
    border-radius:40px;
    background:#ff4081;
    color:#fff;
    font-size:18px;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    transform:scale(1.08);
    background:#e91e63;
}

#pesan{
    margin-top:25px;
    display:none;
    font-size:22px;
    font-weight:bold;
    animation:fade .8s;
}

.balloon{
    position:absolute;
    bottom:-120px;
    width:60px;
    height:80px;
    border-radius:50%;
    animation:naik linear infinite;
}

.balloon::after{
    content:"";
    position:absolute;
    left:50%;
    top:80px;
    width:2px;
    height:60px;
    background:#fff;
}

@keyframes naik{
    from{
        transform:translateY(0);
    }
    to{
        transform:translateY(-130vh);
    }
}

@keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.08);}
    100%{transform:scale(1);}
}

@keyframes fade{
    from{
        opacity:0;
        transform:translateY(20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.confetti{
    position:absolute;
    width:10px;
    height:10px;
    top:-10px;
    animation:jatuh linear forwards;
}

@keyframes jatuh{
    to{
        transform:translateY(110vh) rotate(720deg);
    }
}

@media(max-width:600px){

h1{
    font-size:30px;
}

p{
    font-size:18px;
}

#pesan{
    font-size:20px;
}

button{
    width:100%;
}

}
</style>

</head>
<body>

<div class="container">

<h1>🎂 Selamat Ulang Tahun 🎂</h1>

<p>Semoga harimu penuh kebahagiaan dan kejutan yang menyenangkan! 🎉</p>

<button onclick="kejutan()">🎁 Klik Kejutan</button>

<div id="pesan">
❤️ Selamat ulang tahun ma bro <b>PURNAMA</b>, semoga makin gacor, udah itu aja do'anya wkwkwk 🎉😂
</div>

</div>

<script>

// Membuat balon
const warna=[
"#ff4d6d",
"#ffd60a",
"#00c2ff",
"#8aff80",
"#ff9f1c",
"#b5179e"
];

for(let i=0;i<20;i++){

let balon=document.createElement("div");

balon.className="balloon";

balon.style.left=Math.random()*100+"vw";

balon.style.background=warna[Math.floor(Math.random()*warna.length)];

balon.style.animationDuration=(6+Math.random()*6)+"s";

balon.style.animationDelay=Math.random()*5+"s";

document.body.appendChild(balon);

}

// Tombol kejutan
function kejutan(){

document.getElementById("pesan").style.display="block";

// Efek konfeti
for(let i=0;i<250;i++){

let conf=document.createElement("div");

conf.className="confetti";

conf.style.left=Math.random()*100+"vw";

conf.style.background=
`hsl(${Math.random()*360},100%,50%)`;

conf.style.width=(6+Math.random()*8)+"px";
conf.style.height=conf.style.width;

conf.style.animationDuration=(2+Math.random()*3)+"s";

document.body.appendChild(conf);

setTimeout(()=>{
conf.remove();
},5000);

}

}
</script>

</body>
</html>
